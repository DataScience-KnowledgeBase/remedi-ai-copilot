# Copy using scripts\bootstrap.ps1; never copy the GPU application's .env.
OPERATOR_TOKEN=replace-with-distinct-random-operator-token
OWNER_TOKEN=replace-with-distinct-random-owner-token
PROVIDER=copilot
# This pilot sends ONLY synthetic incident evidence to GitHub Copilot.
COPILOT_ALLOW_EGRESS=true
# Change only to a model ID actually listed for your account by SDK list_models.
COPILOT_MODEL=gpt-4.1
COPILOT_HOME=.runtime/copilot
COPILOT_WORK_DIRECTORY=.runtime/work
DATABASE_PATH=data/remedi-copilot.db
FRONTEND_DIST=frontend/dist
LLM_TIMEOUT_SECONDS=90
MAX_AGENT_STEPS=4
MAX_ACTIVE_INCIDENTS=25
REQUESTS_PER_MINUTE=120
CONFIDENCE_THRESHOLD=0.85

# Native mode uses your explicitly signed-in CLI identity via scripts\copilot-login.ps1.
# No VS Code tokens are extracted. Do not paste credentials into chat.
# For containers/server use, provision a supported Copilot-enabled GitHub credential
# through a secret manager and obey organization policy; not a general LLM API key.
# COPILOT_GITHUB_TOKEN=<approved-supported-credential>

# Separate paid-provider alternative; does NOT bill your Copilot subscription:
# PROVIDER=api
# ALLOW_API_EGRESS=true
# API_BASE_URL=https://api.openai.com/v1
# API_MODEL=gpt-4.1-mini
# API_KEY=<server-only-key>
# INPUT_USD_PER_MILLION=<verified-current-rate>
# OUTPUT_USD_PER_MILLION=<verified-current-rate>
